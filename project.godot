; Engine configuration file.
; Godot 4.7 - Stunt Track Racer VR

config_version=5

[application]

config/name="Stunt Track Racer VR"
config/description="VR stunt racer on elevated tracks, inspired by Geoff Crammond's Stunt Car Racer (1989)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
XrManager="*res://scripts/autoload/xr_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Net="*res://scripts/net/net_client.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.333, 0.6, 1, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/reference_space=0
shaders/enabled=true
