	"°": ".##..|#..#.|.##..|.....|.....|.....|.....",
}

static var _cache: Dictionary = {}


static func _rows(ch: String) -> PackedInt32Array:
	if _cache.has(ch):
		return _cache[ch]
	var rows := PackedInt32Array()
	var src: String = GLYPHS.get(ch, GLYPHS["?"])
	for line in src.split("|"):
		var bits := 0
		for i in W:
			if line[i] == "#":
				bits |= 1 << (W - 1 - i)
		rows.append(bits)
	_cache[ch] = rows
	return rows


static func normalize(text: String) -> String:
	return text.replace("ß", "SS").to_upper()


static func text_width(text: String, scale: float) -> float:
	var n := normalize(text).length()
	if n == 0:
		return 0.0
	return (n * ADVANCE - 1) * scale


static func draw_text(canvas: CanvasItem, pos: Vector2, text: String, color: Color, scale: float) -> void:
	var t := normalize(text)
	var x := pos.x
	for i in t.length():
		var rows := _rows(t[i])
		for r in H:
			var bits := rows[r]
			if bits == 0:
				continue
			# merge horizontal runs into one rect
			var c := 0
			while c < W:
				if bits & (1 << (W - 1 - c)):
					var start := c
					while c < W and bits & (1 << (W - 1 - c)):
						c += 1
					canvas.draw_rect(Rect2(x + start * scale, pos.y + r * scale, (c - start) * scale, scale), color)
				else:
					c += 1
		x += ADVANCE * scale
